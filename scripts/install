#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir/sources"

# Add prebuilt libvips with HEIC support
ynh_setup_source --source_id="vips_prebuilt_$YNH_DEBIAN_VERSION" --dest_dir="$install_dir/vips"
export LD_LIBRARY_PATH="$install_dir/vips/lib:${LD_LIBRARY_PATH:-}"
export PKG_CONFIG_PATH="$install_dir/vips/lib/pkgconfig:${PKG_CONFIG_PATH:-}"

mkdir -p "$install_dir/output/"{data,ui}

chown -R "$app:$app" "$install_dir"
chown -R "$app:$app" "$data_dir"

#=================================================
# BUILD APP
#=================================================

ynh_script_progression "Compiling Go API..."
#build_api

pushd $install_dir/sources/api
    export GOPATH="$install_dir/build/go"
	export GOCACHE="$install_dir/build/.cache"

    ynh_hide_warnings ynh_exec_as_app CGO_ENABLED=1 go mod download
    ynh_hide_warnings ynh_exec_as_app CGO_ENABLED=1 go install github.com/mattn/go-sqlite3 github.com/Kagami/go-face
    ynh_hide_warnings ynh_exec_as_app CGO_CFLAGS="$(pkg-config --cflags MagickWand)" CGO_LDFLAGS="$(pkg-config --libs MagickWand)" CGO_ENABLED=1 go build -o photoview .
popd

ynh_script_progression "Building static UI files..."
#build_ui

pushd $install_dir/sources/ui
    ynh_hide_warnings ynh_exec_as_app npm install
	ynh_hide_warnings ynh_exec_as_app npm run build
popd

cp -T "$install_dir/sources/api/photoview" "$install_dir/output/photoview"
cp -rT "$install_dir/sources/api/data" "$install_dir/output/data"
cp -rT "$install_dir/sources/ui/dist" "$install_dir/output/ui"

cleanup_sources

#=================================================
# ADD A CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration file..."

ynh_config_add --template=".env" --destination="$install_dir/output/.env"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

# Create a dedicated NGINX config
ynh_config_add_nginx

# Create a dedicated systemd config
ynh_config_add_systemd
yunohost service add "$app" --description="Photoview photo manager API" --log="/var/log/$app/$app.log"

# Use logrotate to manage application logfile(s)
ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# Start a systemd service
ynh_systemctl --service="$app" --action="start"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
